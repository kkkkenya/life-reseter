# Copy to .env for local dev: cp .env.example .env
# Secrets (server-only, no VITE_ prefix — never shipped to the browser):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# SUPABASE_SERVICE_ROLE_KEY=   # streak-reminder cron job only
# VAPID_PRIVATE_KEY=
# CRON_SECRET=

# Public flags / browser-safe keys (VITE_ prefix = inlined into the client bundle):
VITE_GEMINI_ENABLED=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# Google Calendar connect (OAuth client ID, type: Web application):
VITE_GOOGLE_CLIENT_ID=
